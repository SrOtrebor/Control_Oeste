# ============================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================
# IMPORTANTE: Copia este archivo como ".env" y completa con tus valores reales
# NO subas el archivo .env a Git (ya está en .gitignore)

# Clave secreta de Flask (se generará automáticamente si no existe)
# Puedes generar una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ============================================
# CREDENCIALES DE ADMINISTRADOR
# ============================================
ADMIN_USERNAME=Seguridad
ADMIN_PASSWORD=ControldeAcceso1.0

# ============================================
# CONFIGURACIÓN DE EMAIL
# ============================================
# Email desde el cual se enviarán los reportes
EMAIL_SENDER=acceso.alcorta@gmail.com

# Contraseña de aplicación de Gmail
# Para obtenerla: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=

# Email destino para recibir reportes
EMAIL_RECEIVER=rlaforcada@irsa.com.ar

# Servidor SMTP (Gmail por defecto)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
